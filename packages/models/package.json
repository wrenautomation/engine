{
  "name": "@wrenautomation/models",
  "version": "0.25.0",
  "description": "One door to every model: a Model takes text, image, video, audio and PDF parts, answers with text, tokens and USD, and parses an answer to a zod shape. Adapters for Anthropic, Gemini, Cohere, any OpenAI-compatible server and a shell command (claude -p); ears for speech to text; a judge (Jev) for typed yes, no, pick and score answers; one price table; one key ring.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/engine.git",
    "directory": "packages/models"
  },
  "license": "PolyForm-Strict-1.0.0",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prices": {
      "types": "./dist/prices.d.ts",
      "import": "./dist/prices.js"
    },
    "./hear": {
      "types": "./dist/hear.d.ts",
      "import": "./dist/hear.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js"
    },
    "./judge": {
      "types": "./dist/judge.d.ts",
      "import": "./dist/judge.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sh ../../scripts/build.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/cohere": "4.0.71",
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "7.0.155",
    "zod": "4.6.5"
  }
}
