{
  "name": "@wrenautomation/birdwatch",
  "version": "0.30.0",
  "description": "Research from the open web, driven by an agent one step per command: plan, search, triage, open, extract behind a quote gate, check, review, every record in a ledger. The agent decides; the engine runs the fixed steps. The ask and plan files, the document side (Document, Finding, Proof, the claim extractor), the sources (SearXNG, Exa, Google, arXiv, YouTube, Reddit, Facebook, the fetch ladder) and the ledger. One CLI, `birdwatch`, with the readers of @wrenautomation/read on it.",
  "license": "PolyForm-Strict-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/engine.git",
    "directory": "packages/birdwatch"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    }
  },
  "bin": {
    "birdwatch": "dist/app/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sh ../../scripts/build.sh app/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@wrenautomation/models": "workspace:*",
    "@wrenautomation/read": "workspace:*",
    "commander": "15.0.0",
    "hono": "4.13.12",
    "htmlparser2": "12.0.0",
    "minisearch": "7.2.0",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  }
}
