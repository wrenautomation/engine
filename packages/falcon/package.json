{
  "name": "@wrenautomation/falcon",
  "version": "0.13.0",
  "description": "Files, markup and media in; text and quoted facts out. HTML and PDF to text, a page to title, text and links, video watching with ffmpeg and a vision model, captions and audio to markdown, a study's synthesis reader whose every claim quotes a page, and the research engine's document side: Document, Finding, Proof and Verdict, readers by media, the claim extractor with its verdict on each document. Fetching is weaver's.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/engine.git",
    "directory": "packages/falcon"
  },
  "license": "PolyForm-Strict-1.0.0",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    },
    "./study": {
      "types": "./dist/study/index.d.ts",
      "import": "./dist/study/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    }
  },
  "bin": {
    "falcon": "dist/app/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && chmod +x dist/app/cli.js"
  },
  "dependencies": {
    "@wrenautomation/models": "workspace:*",
    "commander": "15.0.0",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  }
}
