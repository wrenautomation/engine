{
  "name": "@wrenautomation/weaver",
  "version": "0.24.1",
  "description": "The web in, documents out. Polite HTTP fetching with robots and a fetch ladder up to a browser; YouTube, any other video and podcasts read from a URL through yt-dlp and @wrenautomation/falcon; what a channel or search holds. The sources, runner and ledger of Wren's research engine: `weaver run` takes an ask through plan, fetch, triage, read, extract, check and review, every record in a folder.",
  "license": "PolyForm-Strict-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/engine.git",
    "directory": "packages/weaver"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "import": "./dist/fetch/index.js"
    },
    "./ledger": {
      "types": "./dist/ledger/index.d.ts",
      "import": "./dist/ledger/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    }
  },
  "bin": {
    "weaver": "dist/app/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sh ../../scripts/build.sh app/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@wrenautomation/falcon": "workspace:*",
    "@wrenautomation/models": "workspace:*",
    "@wrenautomation/raven": "workspace:*",
    "commander": "15.0.0",
    "hono": "4.13.12",
    "minisearch": "7.2.0",
    "robots-parser": "3.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  }
}
