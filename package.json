{
  "name": "@wrenautomation/engine-workspace",
  "private": true,
  "version": "0.27.1",
  "type": "module",
  "description": "The research engine (models, raven, falcon, weaver) and the map engine (orrery), one npm package each.",
  "license": "PolyForm-Strict-1.0.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "gates": "lockf -t 900 /tmp/wren_automation-checks.lock sh -c 'pnpm lint && pnpm build && pnpm test'",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  }
}
