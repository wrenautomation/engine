{
  "name": "@wrenautomation/raven",
  "version": "0.1.2",
  "description": "Ask in, plan out. The planner of Wren's research engine: typed queries with who proposed them and why, proposals merged into one plan under a plan file per ask kind, read-or-skip on hits, and the edge to take after a round. Pure functions and prompts; the model is injected.",
  "license": "PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/raven.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "raven": "dist/app/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && chmod +x dist/app/cli.js",
    "test": "vitest run",
    "gates": "lockf -t 900 /tmp/wren_automation-checks.lock sh -c 'pnpm lint && pnpm typecheck && pnpm test'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
